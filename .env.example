# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./gov_grants.db

# For Azure PostgreSQL
# DATABASE_URL=postgresql://username:password@servername.postgres.database.azure.com:5432/gov_grants?sslmode=require

# For Azure SQL Server
# DATABASE_URL=mssql+pyodbc://username:password@servername.database.windows.net:1433/gov_grants?driver=ODBC+Driver+17+for+SQL+Server

# API Configuration
API_TITLE=Government Grants API
API_VERSION=1.0.0
API_DESCRIPTION=API for searching and managing government grant opportunities

# Security / JWT
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-before-deploying
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Grants.gov API (when we integrate in Week 3)
GRANTS_GOV_API_KEY=your-grants-gov-api-key

# Azure OpenAI (grant enrichment pipeline)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Configuration
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=grant-documents
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_KEY_VAULT_NAME=gov-grants-msu

# Rate Limiting (documented here; configured in app/rate_limit.py)
# RATE_LIMIT_PER_MINUTE=100

# Email/Notification Settings (will be used in Week 7)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@govgrants.com

# Application Settings
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Pipeline configuration (optional — defaults shown)
# TARGET_QUALITY_SCORE=0.80
# MIN_QUALITY_SCORE=0.50
# HIGH_QUALITY_SCORE=0.70
# REVIEW_BELOW_SCORE=0.70
# MIN_AWARD_THRESHOLD=5000
# AI_TEXT_LIMIT=8000
# AI_CALL_TIMEOUT=30
# PASS2_LIMIT=50
# MAX_CONCURRENT_AI_CALLS=3
# MAX_CONCURRENT_HTTP=10
# DEADLINE_MIN_YEAR=2020
# DEADLINE_MAX_YEAR=2030

# Scraper configuration (optional — defaults shown)
# REQUEST_TIMEOUT=10
# PDF_REQUEST_TIMEOUT=30
# REQUEST_DELAY=1.2
# MIN_PDF_CHARS=300
# MAX_PDF_PAGES=15
# MAX_RETRIES=2
# RETRY_INITIAL_DELAY=1.0
# RETRY_BACKOFF_FACTOR=2.0